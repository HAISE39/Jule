{
  LinearLayout,
  layout_width="fill",
  layout_height="fill",
  background="#121212",
  orientation="vertical",
  gravity="center",
  {
    CardView,
    layout_width="85%w",
    layout_height="wrap",
    cardElevation="6dp",
    cardBackgroundColor="#202428",
    radius="15dp",
    layout_gravity="center",
    {
      LinearLayout,
      orientation="vertical",
      layout_width="fill",
      layout_height="wrap",
      padding="16dp",
      gravity="center",
      {
        TextView,
        text="AURCUS INJECTOR",
        textSize="20sp",
        textColor="#FFFFFF",
        textStyle="bold",
        gravity="center",
        layout_marginBottom="8dp",
      },
      {
        TextView,
        id="status_text",
        text="Status: Ready",
        layout_width="fill",
        layout_height="wrap",
        textSize="14sp",
        textColor="#4CAF50",
        gravity="center",
        layout_marginBottom="20dp",
      },
      {
        LinearLayout,
        layout_width="fill",
        layout_height="wrap",
        orientation="vertical",
        {
          LinearLayout,
          layout_width="fill",
          layout_height="wrap",
          orientation="horizontal",
          layout_marginBottom="12dp",
          {
            CardView,
            layout_width="0dp",
            layout_height="wrap",
            layout_weight="1",
            cardElevation="4dp",
            cardBackgroundColor="#252525",
            radius="12dp",
            layout_marginRight="6dp",
            {
              Button,
              id="btn_start",
              text="START",
              layout_width="fill",
              layout_height="70dp",
              textColor="#4CAF50",
              background="#00000000",
            }
          },
          {
            CardView,
            layout_width="0dp",
            layout_height="wrap",
            layout_weight="1",
            cardElevation="4dp",
            cardBackgroundColor="#252525",
            radius="12dp",
            layout_marginLeft="6dp",
            {
              Button,
              id="btn_stop",
              text="STOP",
              layout_width="fill",
              layout_height="70dp",
              textColor="#F44336",
              background="#00000000",
            }
          }
        },
        {
          LinearLayout,
          layout_width="fill",
          layout_height="wrap",
          orientation="horizontal",
          {
            CardView,
            layout_width="0dp",
            layout_height="wrap",
            layout_weight="1",
            cardElevation="4dp",
            cardBackgroundColor="#252525",
            radius="12dp",
            layout_marginRight="6dp",
            {
              Button,
              id="btn_game",
              text="GAME",
              layout_width="fill",
              layout_height="70dp",
              textColor="#FFFFFF",
              background="#00000000",
            }
          },
          {
            CardView,
            layout_width="0dp",
            layout_height="wrap",
            layout_weight="1",
            cardElevation="4dp",
            cardBackgroundColor="#252525",
            radius="12dp",
            layout_marginLeft="6dp",
            {
              Button,
              id="btn_exit",
              text="EXIT",
              layout_width="fill",
              layout_height="70dp",
              textColor="#FFFFFF",
              background="#00000000",
            }
          }
        }
      }
    }
  },
  {
    TextView,
    text="com.asobimo.aurcusonline.wx",
    layout_width="wrap",
    layout_height="wrap",
    textColor="#666666",
    textSize="12sp",
    layout_marginTop="20dp",
  }
}
